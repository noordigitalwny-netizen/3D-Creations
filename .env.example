# Tina Cloud credentials (required for production authentication on Vercel)
# Sign up and create a project at https://tina.io to get these values.
NEXT_PUBLIC_TINA_CLIENT_ID=your-tina-client-id-here
TINA_TOKEN=your-tina-token-here

# Target Git branch for Tina Cloud content edits (defaults to 'main')
NEXT_PUBLIC_TINA_BRANCH=main
